.env
__pycache__/

# Machine-local project config (keep .claude/memory/ tracked)
.claude/settings.local.json

# Per-host infrastructure inventories. THIS REPO IS PUBLIC. A manifest names every hostname on a box, the
# exact string each site emits to prove the right app is answering, and which routes are deliberately hidden
# and why — no credentials, which is what makes it easy to publish by accident. Nothing is meant to live here:
# per-host data belongs to the private repo that owns the host, and IDENTITY_CHECK fetches it at publish time
# rather than keeping a copy. This rule is a tombstone — it stops the path being recreated by someone repeating
# the reasoning that put a manifest here once before. Full note in README.md § Global Installation.
/claude/hosts/

# Machine-local: which skills are deliberately not committed. Per-machine because
# the set of locally-installed skills differs between them.
claude/untracked-skills.local.txt

# Ignore all skills, whitelist ours
claude/skills/*
!claude/skills/annotate/
!claude/skills/backup/
!claude/skills/build/
!claude/skills/clean-code/
!claude/skills/cleanup/
!claude/skills/commit/
!claude/skills/deploy/
!claude/skills/document-data-flow/
!claude/skills/documentation/
!claude/skills/doppler/
!claude/skills/github-create/
!claude/skills/github-pages/
!claude/skills/github-status/
claude/skills/github-status/config/
!claude/skills/hooks/
!claude/skills/memo/
!claude/skills/move-project/
!claude/skills/notion/
!claude/skills/plan-ralphex/
!claude/skills/plannotator-update/
!claude/skills/pr-create/
!claude/skills/pr-merge/
!claude/skills/pr-prepare/
!claude/skills/publish/
!claude/skills/publish-chrome-extension/
claude/skills/publish-chrome-extension/config/
!claude/skills/reflect/
!claude/skills/release/
!claude/skills/reset/
!claude/skills/shared/
!claude/skills/skill/
!claude/skills/transcrypt/
