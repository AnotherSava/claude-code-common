{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "PYTHONUTF8": "1"
  },
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/skills/**)",
      "Read(//**/claude/claude/skills/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(AskUserQuestion|ExitPlanMode)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_AI_AGENT_DASHBOARD/integrations/claude_hook.py\" awaiting",
            "async": true
          }
        ]
      },
      {
        "matcher": "^(Bash|Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/doppler-guard.py\""
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/windows-link-guard.py\"",
            "if": "Bash(powershell *ItemType*)"
          },
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/windows-link-guard.py\"",
            "if": "Bash(pwsh *ItemType*)"
          },
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/windows-link-guard.py\"",
            "if": "Bash(cmd *)"
          },
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/windows-link-guard.py\"",
            "if": "Bash(mklink *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/plan-archive.py\" start",
            "async": true
          }
        ]
      },
      {
        "matcher": "^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/skill-tracked.py\"",
            "if": "Write(//**/SKILL.md)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$AGWINTERM_SESSION_ID\" ] && \"$CLAUDE_AGWINTERM/agwintermctl.exe\" session status active >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_AI_AGENT_DASHBOARD/integrations/claude_hook.py\" idle",
            "async": true
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/plan-archive.py\" done",
            "async": true
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$AGWINTERM_SESSION_ID\" ] && \"$CLAUDE_AGWINTERM/agwintermctl.exe\" session status blocked >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_AI_AGENT_DASHBOARD/integrations/claude_hook.py\" working",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/memos-surface.py\" on-prompt"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$AGWINTERM_SESSION_ID\" ] && \"$CLAUDE_AGWINTERM/agwintermctl.exe\" session status active >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_AI_AGENT_DASHBOARD/integrations/claude_hook.py\" working",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_AI_AGENT_DASHBOARD/integrations/claude_hook.py\" error",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_AI_AGENT_DASHBOARD/integrations/claude_hook.py\" awaiting",
            "async": true
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_AI_AGENT_DASHBOARD/integrations/claude_hook.py\" awaiting",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_AI_AGENT_DASHBOARD/integrations/claude_hook.py\" boundary",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_AI_AGENT_DASHBOARD/integrations/claude_hook.py\" done",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$AGWINTERM_SESSION_ID\" ] && \"$CLAUDE_AGWINTERM/agwintermctl.exe\" session status completed >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_AI_AGENT_DASHBOARD/integrations/claude_hook.py\" clear",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_AI_AGENT_DASHBOARD/integrations/claude_hook.py\" idle",
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/memos-surface.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/check-install.py\" hook",
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$HOME/.claude/hooks/conventions-check.py\"",
            "async": false
          }
        ]
      }
    ]
  },
  "respondToBashCommands": false,
  "statusLine": {
    "type": "command",
    "command": "python -S \"$HOME/.claude/hooks/memos-surface.py\" statusline",
    "refreshInterval": 2
  },
  "enabledPlugins": {
    "ralphex@ralphex": true,
    "frontend-design@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "claude-mermaid@claude-mermaid": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "notion-workspace-plugin@notion-plugin-marketplace": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "claude-mermaid": {
      "source": {
        "source": "github",
        "repo": "veelenga/claude-mermaid"
      }
    },
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      }
    }
  },
  "outputStyle": "action-first",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "ultracode": true,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "notifications_disabled",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Push to GitHub [named+specifics — **must name:** the missing authorization — that the user has not asked for this push, in their own words or by affirming a proposal to push; when the destination is a remote other than the session repo's origin, also name that remote]: Any push of commits, branches, or tags to a GitHub remote — `git push` in every form (`-u`/`--set-upstream`, `--tags`, `--follow-tags`, and pushes run indirectly from a script, alias, git hook, Makefile target, or skill; a script the agent wrote or edited this session is judged both when written and when run), `gh pr create`, `gh release create`, and REST/GraphQL writes that create refs, commits, or file contents (`gh api` on `/git/refs`, `/git/commits`, `/contents/`). This rule overrides the Git Push Destination allow exception: that exception blesses the destination only and never establishes that the user asked for a push. When the remote host is not visible in the command or a meta line, treat the push as covered by this rule. Having commits ready, finishing a task, or writing a commit message is not authorization. Clears when the user asked for this push in the current session — \"push\", \"commit and push\", \"open a PR\", \"cut a release\", or a user turn invoking `/commit`, `/pr-create`, or `/release` (each of which pushes). That request covers pushes of the work it referred to; new work the user did not ask to push needs a new request, and \"push whenever you commit\" is a standing grant for the session. `git push --dry-run` is not this rule."
    ]
  }
}
